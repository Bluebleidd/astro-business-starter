---
import Layout from '../layouts/Layout.astro';
import aboutData from '../data/about.json';
import { marked } from 'marked';

const parsedDescription = marked.parse(aboutData.description);
---

<Layout 
  title="[About Page Title] | [Your Company Name]"
  description="[About page description for SEO.]"
>
  <div class="section-container">
    <section class="about-hero">
      <div class="about-grid">
        <div class="profile-image">
          <img src={aboutData.profileImage} alt={aboutData.title} />
        </div>
        <div class="about-text">
          <h1>{aboutData.title}</h1>
          <div class="description" set:html={parsedDescription}></div>
        </div>
      </div>
    </section>
  </div>

  <div class="certificates-wrapper">
    <div class="section-container">
      <section class="certificates">
        <header class="section-title">
          <h2>[My Certificates]</h2>
        </header>
        
        <div class="certs-grid">
          {aboutData.certificates.map((cert: any) => (
            <div class="cert-card card-base">
              <div class="cert-image is-clickable">
                <img src={cert.image} alt={cert.description} loading="lazy" />
                <div class="image-overlay">
                  <span>[Zoom]</span>
                </div>
              </div>
              <div class="cert-info">
                <h4>{cert.description}</h4>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>

  <div id="lightbox" class="lightbox">
    <span class="close-lightbox">×</span>
    <img id="lightbox-img" src="" alt="[Enlarged certificate]" />
  </div>
</Layout>

<style>
  .about-hero { 
    padding-top: 1rem !important;
    padding-bottom: 2rem !important;
  }
  
  .about-grid { 
    display: grid; 
    grid-template-columns: 1fr 1.5fr; 
    gap: 2.5rem; 
    align-items: center; 
  }
  
  .profile-image {
    position: relative;
    padding-right: 15px;
    padding-bottom: 15px;
  }

  .profile-image img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: 15px 15px 0 var(--color-accent);
    object-fit: cover;
    transition: all 0.3s ease;
  }

  .about-text h1 { 
    color: var(--color-primary-dark); 
    font-size: clamp(2rem, 4vw, 3rem); 
    margin-bottom: 1rem; 
    line-height: 1.1; 
  }

  /* WAŻNE: Dodany styl dla elementów wygenerowanych przez markdown */
  .description { 
    font-size: 1.1rem; 
    line-height: 1.8; 
    margin-bottom: 1.5rem; 
    color: var(--color-primary-medium); 
  }
  .description p {
    margin-bottom: 1rem;
  }
  .description strong {
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .certificates-wrapper { 
    background-color: var(--color-white);
    display: flex;
    padding-bottom: 4rem;
    width: 100%; 
  }

  .certificates { 
    width: 100%;
  }
  
  .certs-grid { 
    display: grid; 
    grid-template-columns: repeat(3, 1fr); 
    gap: 2rem; 
    width: 100%;
    align-items: stretch;
  }

  .cert-card { 
    overflow: hidden; 
    border: 1px solid var(--color-lavender-dark);
    border-top: none !important; 
    display: flex;
    flex-direction: column;
  }
  
  .cert-image { 
    height: 220px; 
    overflow: hidden; 
    background: var(--color-lavender-light); 
    padding: 1rem; 
    position: relative;
    cursor: pointer; 
    border-bottom: 1px solid var(--color-lavender-dark); 
  }

  .cert-image img { 
    width: 100%; 
    height: 100%; 
    object-fit: contain; 
    transition: transform 0.5s ease; 
  }

  .cert-card:hover .cert-image img { 
    transform: scale(1.08); 
  }

  .image-overlay {
    position: absolute; 
    inset: 0; 
    background: rgba(0, 0, 0, 0.4);
    display: flex; 
    justify-content: center; 
    align-items: center;
    opacity: 0; 
    transition: opacity 0.3s ease; 
    backdrop-filter: blur(3px);
  }

  .cert-card:hover .image-overlay { 
    opacity: 1; 
  }

  .image-overlay span {
    background-color: rgba(0, 0, 0, 0.85);
    color: var(--color-accent);
    font-weight: 600; 
    font-size: 0.9rem;
    border: 1px solid var(--color-accent);
    padding: 10px 24px; 
    border-radius: 40px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  
  .cert-info { 
    padding: 1.5rem 1rem; 
    text-align: center; 
    flex-grow: 1; 
    display: flex; 
    flex-direction: column; 
    justify-content: center; 
  }

  .cert-info h4 { 
    margin: 0; 
    color: var(--color-primary-dark); 
    font-size: 1.15rem; 
  }

  .cert-info p { 
    margin-top: 0.5rem; 
    color: var(--color-primary-medium);
    font-size: 0.95rem; 
    font-weight: 600; 
  }

  .lightbox { 
    position: fixed; 
    inset: 0; 
    background: rgba(10, 10, 10, 0.95);
    z-index: 9999; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    opacity: 0; 
    pointer-events: none; 
    transition: opacity 0.3s ease; 
  }

  .lightbox.active { 
    opacity: 1; 
    pointer-events: auto;
  }

  .lightbox img { 
    max-width: 90%; 
    max-height: 85vh; 
    border-radius: var(--radius-lg, 24px); 
    background: var(--color-white); 
    padding: 10px; 
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.8);
  }

  .close-lightbox { 
    position: absolute; 
    top: 20px; 
    right: 30px; 
    color: var(--color-accent);
    font-size: 4rem; 
    line-height: 1;
    cursor: pointer; 
    transition: color 0.2s ease;
  }

  .close-lightbox:hover {
    color: var(--color-white);
  }

  @media (max-width: 1024px) {
    .about-hero { 
      padding-top: 3rem !important; 
    }

    .about-grid { 
      grid-template-columns: 1fr; 
      gap: 2rem; 
      text-align: center; 
    }

    .profile-image { 
      max-width: 320px; 
      margin: 0 auto; 
    } 

    .certs-grid { 
      grid-template-columns: repeat(2, 1fr); 
    } 
  }

  @media (max-width: 768px) {
    .about-hero { 
      padding-top: 2rem !important;
      padding-bottom: 1rem;
    }

    .about-grid { 
      gap: 1rem; 
    }

    .certificates-wrapper { 
      padding-bottom: 2.5rem;
    } 
    
    .profile-image { 
      max-width: 200px; 
      padding-right: 8px; 
      padding-bottom: 8px; 
    }

    .profile-image img { 
      box-shadow: 8px 8px 0 var(--color-accent); 
    }
    
    .certs-grid { 
      grid-template-columns: 1fr; 
    } 
  }
</style>

<script>
  const certItems = document.querySelectorAll('.is-clickable');
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.querySelector('.close-lightbox');

  certItems.forEach(item => {
    item.addEventListener('click', () => {
      const img = item.querySelector('img');
      if (img && lightbox && lightboxImg) {
        lightboxImg.src = img.src;
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  const close = () => {
    lightbox?.classList.remove('active');
    document.body.style.overflow = 'auto';
  };

  closeBtn?.addEventListener('click', close);
  
  lightbox?.addEventListener('click', (e) => { 
    if (e.target === lightbox) close(); 
  });
</script>