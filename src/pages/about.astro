---
import Layout from '../layouts/Layout.astro';
import aboutData from '../data/about.json';
import { marked } from 'marked';
import { Image } from 'astro:assets';

const parsedDescription = marked.parse(aboutData.description);
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/uploads/*.{jpeg,svg,jpg,png,gif,webp,AVIF}');

const profileImageObj = images[aboutData.profileImage] ? await images[aboutData.profileImage]() : null;
---

<Layout
  title="[About Us] | [Your Company Name]" 
  description="[Brief description of your company for SEO.]">
  <div class="section-container">
    <section class="about-hero">
      <div class="about-grid">
        <div class="profile-image">
          {profileImageObj ? (
            <Image 
              src={profileImageObj.default} 
              alt={aboutData.title} 
              width={450} 
              height={550} 
              loading="eager" 
            />
          ) : (
            <img src={aboutData.profileImage} alt={aboutData.title} />
          )}
        </div>
        <div class="about-text">
          <h1>{aboutData.title}</h1>
          <div class="description" set:html={parsedDescription}></div>
        </div>
      </div>
    </section>
  </div>

  <div class="certificates-wrapper">
    <div class="section-container">
      <section class="certificates">
        <header class="section-title">
          <h2>[My Certificates]</h2>
        </header>
        
        <div class="certs-grid">
          {aboutData.certificates.map(async (cert: any) => {
            const imageObj = images[cert.image] ? await images[cert.image]() : null;
            const fullSrc = imageObj ? imageObj.default.src : cert.image;

            return (
              <div class="cert-card card-base">
                <div class="cert-image is-clickable" data-full={fullSrc}>
                  {imageObj ? (
                    <Image src={imageObj.default} alt={cert.name} width={350} height={250} />
                  ) : (
                    <img src={cert.image} alt={cert.name} loading="lazy" />
                  )}
                  <div class="image-overlay">
                    <span>Powiększ</span>
                  </div>
                </div>
                <div class="cert-info">
                  <h3>{cert.name}</h3>
                  {cert.date && <p>{cert.date}</p>}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    </div>
  </div>

  <div id="lightbox" class="lightbox">
    <span class="close-lightbox">×</span>
    <img id="lightbox-img" src="" alt="[Lightbox Image]" width="1200" height="900" />
  </div>
</Layout>

<style>
  .about-hero {
    padding-top: 1rem !important;
    padding-bottom: 2rem !important;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 2.5rem;
    align-items: center;
  }

  .profile-image {
    position: relative;
    padding-right: 15px;
    padding-bottom: 15px;
  }

  .profile-image img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 550px;
    object-fit: contain;
    aspect-ratio: auto !important;
    border-radius: var(--radius-lg);
    box-shadow: 15px 15px 0 var(--color-accent);
    background-color: var(--color-lavender-light);
    padding: 20px;
    box-sizing: border-box;
    transition: all 0.3s ease;
  }

  .about-text h1 {
    color: var(--color-primary-dark);
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .description {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    color: var(--color-primary-medium);
  }

  .description p {
    margin-bottom: 1rem;
  }

  .description strong {
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .certificates-wrapper {
    background-color: var(--color-white);
    display: flex;
    padding-bottom: 4rem;
    width: 100%;
  }

  .certificates {
    width: 100%;
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    width: 100%;
    align-items: stretch;
  }

  .cert-card {
    overflow: hidden;
    border: 1px solid var(--color-lavender-dark);
    border-top: none !important;
    display: flex;
    flex-direction: column;
  }

  .cert-image {
    height: 220px;
    overflow: hidden;
    background: var(--color-lavender-light);
    padding: 1rem;
    position: relative;
    cursor: pointer;
    border-bottom: 1px solid var(--color-lavender-dark);
  }

  .cert-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s ease;
  }

  .cert-card:hover .cert-image img {
    transform: scale(1.08);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    backdrop-filter: blur(3px);
  }

  .cert-card:hover .image-overlay {
    opacity: 1;
  }

  .image-overlay span {
    background-color: rgba(0, 0, 0, 0.85);
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.9rem;
    border: 1px solid var(--color-accent);
    padding: 10px 24px;
    border-radius: 40px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .cert-info {
    padding: 1.5rem 1rem;
    text-align: center;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .cert-info h3 {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .cert-info p {
    margin-top: 0.5rem;
    color: var(--color-primary-medium);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 10, 0.95);
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .lightbox.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox img {
    max-width: 95vw;
    max-height: 92vh;
    width: auto;
    height: auto;
    border-radius: var(--radius-lg, 24px);
    background: var(--color-white);
    padding: 5px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.8);
    object-fit: contain;
    aspect-ratio: 4 / 3;
  }

  .close-lightbox {
    position: absolute;
    top: 20px;
    right: 30px;
    color: var(--color-accent);
    font-size: 4rem;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .close-lightbox:hover {
    color: var(--color-white);
  }

  @media (max-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .profile-image {
      max-width: 320px;
      margin: 0 auto;
    }
    .certs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .about-hero {
      padding-top: 2rem !important;
      padding-bottom: 1rem;
    }
    .about-grid {
      gap: 1rem;
    }
    .certificates-wrapper {
      padding-bottom: 2.5rem;
    }
    .profile-image {
      max-width: 200px;
      padding-right: 8px;
      padding-bottom: 8px;
    }
    .profile-image img {
      box-shadow: 8px 8px 0 var(--color-accent);
    }
    .certs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const certItems = document.querySelectorAll('.is-clickable');
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.querySelector('.close-lightbox');

  certItems.forEach(item => {
    item.addEventListener('click', () => {
      const fullSrc = (item as HTMLElement).dataset.full;
      if (fullSrc && lightbox && lightboxImg) {
        lightboxImg.src = fullSrc;
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  const close = () => {
    lightbox?.classList.remove('active');
    document.body.style.overflow = 'auto';
  };

  closeBtn?.addEventListener('click', close);
  lightbox?.addEventListener('click', (e) => { 
    if (e.target === lightbox) close(); 
  });
</script>