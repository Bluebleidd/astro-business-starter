---
import { Image } from 'astro:assets';

interface Props {
  beforeImage: any;
  afterImage: any;
  altText?: string;
}

const { beforeImage, afterImage, altText = "[Alt text]" } = Astro.props;
---

<div class="ba-slider-container js-ba-container">
  <div class="ba-image ba-image-after">
    <Image 
      src={afterImage} 
      alt={`Po: ${altText}`} 
      width={1000} 
      height={750} 
      format="webp"
      quality="high"
      loading="lazy" 
    />
    <span class="ba-label label-after">AFTER</span>
  </div>

  <div class="ba-image ba-image-before js-ba-before" style="width: 50%;">
    <Image 
      src={beforeImage} 
      alt={`Przed: ${altText}`} 
      class="js-ba-before-img" 
      width={1000} 
      height={750} 
      format="webp"
      quality="high"
      loading="lazy" 
    />
    <span class="ba-label label-before">BEFORE</span>
  </div>

  <input 
    type="range" 
    min="0" 
    max="100" 
    value="50" 
    class="ba-range js-ba-slider" 
    aria-label="Move slider to compare before and after images" 
  />

  <div class="ba-handle js-ba-handle" style="left: 50%;">
    <div class="ba-handle-line"></div>
    <div class="ba-handle-button">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6"/>
      </svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(180deg);">
        <path d="m9 18 6-6-6-6"/>
      </svg>
    </div>
  </div>
</div>

<style>
  .ba-slider-container {
    position: relative;
    width: 100%;
    margin: 0 auto;
    border-radius: var(--radius-lg, 24px);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    aspect-ratio: 4/3; 
    background-color: var(--color-lavender-dark);
    contain: layout; 
  }

  .ba-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .ba-image :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
    display: block;
    max-width: none;
    position: absolute;
    top: 0;
    left: 0;
    transition: none !important; 
  }

  .ba-image-after {
    z-index: 1;
  }

  .ba-image-before {
    width: 50%;
    overflow: hidden;
    z-index: 2;
    border-right: 2px solid rgba(255, 255, 255, 0.5);
  }

  .ba-label {
    position: absolute;
    top: 20px;
    background-color: rgba(0, 0, 0, 0.75);
    color: var(--color-accent);
    font-weight: 700; 
    font-size: 0.75rem;
    border: 1px solid var(--color-accent);
    padding: 6px 16px; 
    border-radius: 40px;
    text-transform: uppercase; 
    letter-spacing: 0.1em;
    z-index: 5;
    pointer-events: none;
    backdrop-filter: blur(4px);
  }

  .label-before { left: 20px; }
  .label-after { right: 20px; }

  .ba-range {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 10;
    cursor: ew-resize;
    margin: 0;
  }

  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 3;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .ba-handle-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    background-color: var(--color-accent);
    transform: translateX(-50%);
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
  }

  .ba-handle-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    background-color: var(--color-primary-dark);
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--color-accent);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
  }

  .ba-handle-button svg {
    width: 18px;
    height: 18px;
    margin: -3px;
  }

  @media (max-width: 768px) {
    .ba-label {
      top: 10px;
      padding: 4px 12px;
      font-size: 0.65rem;
    }
    .label-before { left: 10px; }
    .label-after { right: 10px; }
    .ba-handle-button {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
  function initSliders() {
    const containers = document.querySelectorAll('.js-ba-container');
    
    containers.forEach(container => {
      const slider = container.querySelector('.js-ba-slider') as HTMLInputElement;
      const beforeImage = container.querySelector('.js-ba-before') as HTMLElement;
      const handle = container.querySelector('.js-ba-handle') as HTMLElement;
      const beforeImgTag = container.querySelector('.js-ba-before-img') as HTMLImageElement;

      const syncWidth = () => {
        const width = (container as HTMLElement).offsetWidth;
        if (beforeImgTag && width > 0) {
          beforeImgTag.style.width = `${width}px`;
        }
      };

      const resizer = new ResizeObserver(() => {
        syncWidth();
      });
      resizer.observe(container);

      if (slider && beforeImage && handle) {
        slider.addEventListener('input', (e) => {
          const value = (e.target as HTMLInputElement).value;
          beforeImage.style.width = `${value}%`;
          handle.style.left = `${value}%`;
        });
      }

      syncWidth();
    });
  }

  initSliders();
  document.addEventListener('astro:after-swap', initSliders);
</script>